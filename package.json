{
  "name": "picfast-obsidian-plugin",
  "version": "0.1.0",
  "description": "Obsidian plugin: paste/drop images to upload to PicFast — skip the PicGo middleman.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "image",
    "uploader",
    "picfast",
    "paste",
    "screenshot",
    "markdown"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "builtin-modules": "^4.0.0",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}